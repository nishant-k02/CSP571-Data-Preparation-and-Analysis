library(glmnet)
library(tidyverse)
library(ggplot2)
library(ggrepel)
library(boot)
data <- read.table("midterm_a_data.csv", sep=",", header=TRUE)
# Identify outliers using the IQR method
Q1 <- quantile(data$response, 0.25)
Q3 <- quantile(data$response, 0.75)
iqr_value <- Q3 - Q1
lower_limit <- Q1 - 1.5 * iqr_value
upper_limit <- Q3 + 1.5 * iqr_value
# Label each observation by its group, marking outliers separately
data <- data %>%
mutate(
label = ifelse(response < lower_limit | response > upper_limit,
"Outlier",
as.character(feat2))
)
# Create a scatter plot of feat1 vs response, with outliers highlighted
plot_1 <- ggplot(data, aes(x = feat1, y = response, color = label)) +
geom_point(size = 2.5, alpha = 0.6) +
scale_color_manual(
values = c("a" = "magenta",
"b" = "green",
"c" = "blue",
"Outlier" = "red"),
name = "Group / Outlier"
) +
labs(
x = "x1 (feat1)",
y = "y (response)",
title = "Scatter Plot of feat1 vs response with Outlier Detection"
) +
theme_minimal() +
theme(legend.position = "right")
print(plot_1)
# Identify and remove outliers based on absolute z-score threshold
z_threshold <- 3
# Split data into outliers and cleaned dataset
outliers_df <- subset(data, abs(z_response) > z_threshold)
# Use the existing IQR-based labels
outliers_df <- subset(data, label == "Outlier")
clean_data  <- subset(data, label != "Outlier")
# Report summary
message("Outliers removed: ", nrow(outliers_df))
message("Data points remaining: ", nrow(clean_data))
