# Compute absolute z-scores and remove outliers in one go
z_limit <- 3
# Separate outliers using subset for variety
outliers_df <- subset(data, abs(z_response) > z_limit)
clean_data <- subset(data, abs(z_response) <= z_limit)
# Display summary of removal
num_out <- nrow(outliers_df)
num_left <- nrow(clean_data)
message("Outliers removed: ", num_out)
message("Data points remaining: ", num_left)
# Fit a multiple linear regression model on the cleaned dataset (outliers removed)
lm_model <- lm(response ~ feat1 + feat2 + feat3, data = clean_data)
# Show the model summary
summary(lm_model)
set.seed(123)  # Ensure reproducibility
# Initialize a vector to store mean CV errors for polynomial degrees 1–10
cv_error <- numeric(10)
# Compute 5-fold cross-validation error for each polynomial degree
for (deg in 1:10) {
# Fit a polynomial regression model of the specified degree
model <- glm(response ~ poly(feat1, deg), data = clean_data)
# Perform 5-fold cross-validation
cv_result <- cv.glm(clean_data, model, K = 5)
# Record the mean CV error
cv_error[deg] <- cv_result$delta[1]
}
# Plot CV error versus polynomial degree
plot(1:10, cv_error, type = "b",
xlab = "Polynomial Degree",
ylab = "5-Fold CV Error",
main = "Cross-Validation Error by Polynomial Degree")
# Initialize a vector to store AIC values for polynomial degrees 1–10
aic_values <- numeric(10)
# Fit polynomial models (degrees 1–10) and record their AIC scores
for (deg in 1:10) {
model <- glm(response ~ poly(feat1, deg), data = clean_data)
aic_values[deg] <- AIC(model)
}
# Plot AIC versus polynomial degree
plot(1:10, aic_values, type = "b",
xlab = "Polynomial Degree",
ylab = "AIC",
main = "Model Selection Based on AIC")
# Identify and report the degree with the minimum AIC
best_degree <- which.min(aic_values)
cat("Polynomial degree with the lowest AIC:", best_degree, "\n")
