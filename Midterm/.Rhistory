library(glmnet)
library(tidyverse)
library(ggplot2)
library(ggrepel)
library(boot)
data <- read.table("midterm_a_data.csv", sep=",", header=TRUE)
poly_fit <- lm(response ~ poly(feat1, 2), data = data)
data$residual <- resid(poly_fit)
# Define outliers as residuals > 2 * sd or < -2 * sd
threshold <- 2 * sd(data$residual)
data$mod_label <- ifelse(abs(data$residual) > threshold, "outlier", as.character(data$feat2))
# Plot using model-based outliers
p2 <- ggplot(data, aes(x = feat1, y = response, color = mod_label)) +
geom_point(size = 2.5, alpha = 0.5) +
scale_color_manual(
values = c("a" = "magenta",
"b" = "green",
"c" = "blue",
"outlier" = "red"),
name = "Category"
) +
labs(
x = "x1 (feat1)",
y = "y (Response)",
title = "Scatter Plot: Model-based Outliers"
) +
theme_minimal() +
theme(legend.position = "right")
print(p2)
# Compute absolute z-scores and remove outliers in one go
z_limit <- 3
# Separate outliers using subset for variety
outliers_df <- subset(data, abs(z_response) > z_limit)
# Map: x1 -> feat1, y -> response, x2 -> feat2
data <- data %>%
mutate(
z_response = as.numeric(scale(response)),
label_group = ifelse(abs(z_response) > 3, "Outlier", as.character(feat2))
)
# Scatter with text labels from x2 (feat2) and legend including "Outlier"
ggplot(data, aes(x = feat1, y = response, color = label_group)) +
geom_point(size = 2.6) +
geom_text(aes(label = feat2), vjust = -0.8, size = 3, check_overlap = TRUE) +
labs(
title = "x1 (feat1) vs y (response) with labels from x2 (feat2)",
x = "x1 (feat1)", y = "y (response)", color = "Label"
) +
theme_minimal()
