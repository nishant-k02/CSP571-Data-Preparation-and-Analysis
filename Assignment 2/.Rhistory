train <- Weekly$Year < 2009
fit <- glm(Direction ~ Lag2, data = Weekly[train, ], family = binomial)
pred <- predict(fit, Weekly[!train, ], type = "response") > 0.5
(t <- table(ifelse(pred, "Up (pred)", "Down (pred)"), Weekly[!train, ]$Direction))
sum(diag(t)) / sum(t)
# Training data: 1990–2008
train <- (Weekly$Year <= 2008)
# Fit logistic regression with Lag2 as predictor
glm_fit_train <- glm(Direction ~ Lag2, data = Weekly, family = binomial, subset = train)
# Predict on the test set: 2009–2010
test_data <- Weekly[!train, ]
prob_pred_test <- predict(glm_fit_train, newdata = test_data, type = "response")
# Classify based on 0.5 cutoff
pred_class_test <- ifelse(prob_pred_test > 0.5, "Up", "Down")
pred_class_test <- factor(pred_class_test, levels = c("Down", "Up"))
# Actual values for 2009–2010
actual_class_test <- test_data$Direction
# Confusion matrix
conf_mat_test <- table(Predicted = pred_class_test, Actual = actual_class_test)
conf_mat_test
# Overall accuracy
accuracy_test <- mean(pred_class_test == actual_class_test)
accuracy_test
