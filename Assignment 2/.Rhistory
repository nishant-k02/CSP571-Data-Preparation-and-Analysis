install.packages("GGally")
library(ISLR2)
library(ggplot2)
library(GGally)
data("Weekly")
# Numerical summaries
str(Weekly)
summary(Weekly)
cor(Weekly[, sapply(Weekly, is.numeric)])
# Histograms
ggplot(Weekly, aes(x = Today)) +
geom_histogram(binwidth = 0.5, fill="skyblue", color="black") +
labs(title="Histogram of Weekly Returns", x="Today Return", y="Count")
# Scatterplots
ggpairs(Weekly[, c("Lag1","Lag2","Lag3","Lag4","Lag5","Today")])
# Direction counts
ggplot(Weekly, aes(x=Direction)) +
geom_bar(fill="lightgreen") +
labs(title="Count of Up vs Down Weeks", x="Direction", y="Count")
# Time series plot
ggplot(Weekly, aes(x=1:nrow(Weekly), y=Today)) +
geom_line(color="blue") +
labs(title="Weekly Returns Over Time", x="Week Index", y="Today Return")
